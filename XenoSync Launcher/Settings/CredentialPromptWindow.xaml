<Window x:Class="XenoSyncLauncher.Settings.CredentialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam sign-in required"
        Height="260" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}"
        ResizeMode="NoResize">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="MessageText" Text="Enter your Steam password"
                       Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,14"/>

            <!-- Only one of these two is shown at a time, depending on IsPassword -->
            <PasswordBox x:Name="ValuePasswordBox" Height="32" Padding="8,5"
                         Background="{StaticResource BrushPanel}" Foreground="{StaticResource BrushTextPrimary}"
                         BorderBrush="{StaticResource BrushBorder}"/>
            <TextBox x:Name="ValueTextBox" Height="32" Padding="8,5"
                     Background="{StaticResource BrushPanel}" Foreground="{StaticResource BrushTextPrimary}"
                     BorderBrush="{StaticResource BrushBorder}" Visibility="Collapsed"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource BrushDanger}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Text="Verifying..." Foreground="{StaticResource BrushTextSecondary}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Height="25" Margin="0,0,10,0"
                    Style="{StaticResource WizardButton}" Click="CancelButton_Click"/>
            <Button x:Name="OkButton" Content="Continue" Width="100"
                    Style="{StaticResource PrimaryButton}" Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
