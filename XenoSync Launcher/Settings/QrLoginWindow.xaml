<Window x:Class="XenoSyncLauncher.Settings.QrLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in with Steam"
        Height="420" Width="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Scan with the Steam mobile app"
                   Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="White" CornerRadius="4" Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="QrImage" Width="260" Height="260" Stretch="Uniform"/>
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText" Text="Waiting for confirmation..."
                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12"
                   HorizontalAlignment="Center" Margin="0,15,0,0"/>

        <Button Grid.Row="3" x:Name="CancelButton" Content="Cancel" Width="100"
                Style="{StaticResource WizardButton}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Click="CancelButton_Click"/>
    </Grid>
</Window>
