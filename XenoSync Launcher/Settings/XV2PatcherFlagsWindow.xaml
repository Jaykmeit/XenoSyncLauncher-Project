<Window x:Class="XenoSyncLauncher.Settings.XV2PatcherFlagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XV2 Patcher Flags"
        Height="620" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="XV2 Patcher Flags" Foreground="{StaticResource BrushTextPrimary}" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock x:Name="PathStatusText" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="FlagsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  Foreground="{StaticResource BrushTextPrimary}" FontSize="13"
                                  Content="{Binding DisplayName}"
                                  ToolTip="{Binding Description}"
                                  Margin="0,6"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Margin="0,0,10,0"
                    Style="{StaticResource WizardButton}" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="Save" Width="100"
                    Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
