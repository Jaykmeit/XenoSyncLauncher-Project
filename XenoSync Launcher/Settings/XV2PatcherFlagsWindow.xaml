<Window x:Class="XenoSyncLauncher.Settings.XV2PatcherFlagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XV2 Patcher Flags"
        Height="620" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de título personalizada -->
        <Border Grid.Row="0" Background="{StaticResource BrushPanel}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="XV2 Patcher Flags" Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button x:Name="BtnClose" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click"
                        ToolTip="Cerrar" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!-- Contenido original -->
        <Grid Grid.Row="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="XV2 Patcher Flags" Foreground="{StaticResource BrushTextPrimary}" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="PathStatusText" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="FlagsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Foreground="{StaticResource BrushTextPrimary}" FontSize="13"
                                      Content="{Binding DisplayName}"
                                      ToolTip="{Binding Description}"
                                      Margin="0,6"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="CancelButton" Content="Cancel" Width="100" Margin="0,0,10,0"
                        Style="{StaticResource WizardButton}" Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="Save" Width="100"
                        Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
