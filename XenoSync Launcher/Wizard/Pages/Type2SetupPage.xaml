<Page x:Class="XenoSyncLauncher.Wizard.Pages.Type2SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BrushBackground}">
    <StackPanel Margin="50,35,50,0">
        <TextBlock Text="Separate Directory Installation"
                   Foreground="{StaticResource BrushTextPrimary}"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Foreground="{StaticResource BrushTextSecondary}"
                   FontSize="13" TextWrapping="Wrap" Margin="0,0,0,25">
            Xenoverse 2 Modded will be installed in its own folder, separate from Vanilla.
        </TextBlock>

        <TextBlock Text="Modded destination folder (required)" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
            If you select a Vanilla folder below, this defaults to a sibling folder named "DB Xenoverse 2 REVAMP" - you can still Browse to pick a different one.
        </TextBlock>
        <Grid Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ModdedPathTextBox" Grid.Column="0" Height="32" Padding="8,5"
                     Background="{StaticResource BrushPanel}" Foreground="{StaticResource BrushTextPrimary}"
                     BorderBrush="{StaticResource BrushBorder}" IsReadOnly="True"/>
            <Button x:Name="BrowseModdedButton" Grid.Column="1" Content="Browse..." Width="100" Margin="10,0,0,0"
                    Style="{StaticResource WizardButton}" Click="BrowseModdedButton_Click"/>
        </Grid>

        <TextBlock Text="Vanilla folder (optional)" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10">
            Used to check its version against the one supported by Revamp, and to copy it into the
            Modded folder if versions match. Leave empty if you don't have Xenoverse 2 installed yet;
            a fresh download will be performed instead.
        </TextBlock>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="VanillaPathTextBox" Grid.Column="0" Height="32" Padding="8,5"
                     Background="{StaticResource BrushPanel}" Foreground="{StaticResource BrushTextPrimary}"
                     BorderBrush="{StaticResource BrushBorder}" IsReadOnly="True"/>
            <Button x:Name="BrowseVanillaButton" Grid.Column="1" Content="Browse..." Width="100" Margin="10,0,0,0"
                    Style="{StaticResource WizardButton}" Click="BrowseVanillaButton_Click"/>
            <Button x:Name="ClearVanillaButton" Grid.Column="2" Content="Clear" Width="70" Margin="10,0,0,0"
                    Style="{StaticResource WizardButton}" Click="ClearVanillaButton_Click"/>
        </Grid>
    </StackPanel>
</Page>
