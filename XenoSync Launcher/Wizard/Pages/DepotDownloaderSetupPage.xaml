<Page x:Class="XenoSyncLauncher.Wizard.Pages.DepotDownloaderSetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BrushBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="50,35,50,20">
            <TextBlock Text="DepotDownloader"
                       Foreground="{StaticResource BrushTextPrimary}"
                       FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Foreground="{StaticResource BrushTextSecondary}"
                       FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20">
                Your Xenoverse 2 version needs to be downgraded/fetched via DepotDownloader, a tool
                XenoSync Launcher uses to grab the exact game build Revamp supports. Choose how to set it up.
            </TextBlock>

            <RadioButton x:Name="AutoInstallRadio" GroupName="DepotDownloaderSource"
                         Checked="SourceOptionChanged" Margin="0,0,0,4">
                <TextBlock Text="Install it for me (recommended)" Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="SemiBold"/>
            </RadioButton>
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="24,0,0,14">
                Downloads the latest DepotDownloader release and installs it to a default folder managed by XenoSync Launcher.
            </TextBlock>

            <Button x:Name="InstallButton" Content="Install now" Width="140" HorizontalAlignment="Left" Margin="24,0,0,10"
                    Style="{StaticResource PrimaryButton}" Click="InstallButton_Click"/>

            <Grid Margin="24,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar x:Name="InstallProgressBar" Grid.Row="0" Height="6" IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="InstallStatusText" Grid.Row="1" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,6,0,0"/>
            </Grid>

            <RadioButton x:Name="ExistingPathRadio" GroupName="DepotDownloaderSource"
                         Checked="SourceOptionChanged" Margin="0,0,0,4">
                <TextBlock Text="I already have DepotDownloader" Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="SemiBold"/>
            </RadioButton>
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="24,0,0,10">
                Point to an existing DepotDownloader.exe elsewhere on your system.
            </TextBlock>
            <Grid Margin="24,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ExistingPathTextBox" Grid.Column="0" Height="32" Padding="8,5" IsEnabled="False"
                         Background="{StaticResource BrushPanel}" Foreground="{StaticResource BrushTextPrimary}"
                         BorderBrush="{StaticResource BrushBorder}" IsReadOnly="True"/>
                <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Width="100" Margin="10,0,0,0" IsEnabled="False"
                        Style="{StaticResource WizardButton}" Click="BrowseButton_Click"/>
            </Grid>

            <!-- Steam sign-in method: configured here (rather than only in
                 Settings afterwards) so it's already in place before the
                 first real Update, which is what actually runs DepotDownloader.
                 Without this, a fresh install would silently fall back to the
                 QrCode default with no username, until the user happened to
                 visit Settings on their own. -->
            <TextBlock Text="Steam sign-in method" Foreground="{StaticResource BrushTextPrimary}"
                       FontSize="15" FontWeight="SemiBold" Margin="0,30,0,4"/>
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14">
                Used by DepotDownloader to sign in to Steam when a game version download/downgrade is
                needed. You can change this later from Settings.
            </TextBlock>

            <RadioButton x:Name="QrLoginRadio" GroupName="SteamLoginMethod"
                         Checked="LoginMethodOptionChanged" Margin="0,0,0,4">
                <TextBlock Text="QR code (recommended - scan with the Steam mobile app)" Foreground="{StaticResource BrushTextPrimary}" FontSize="13"/>
            </RadioButton>
            <RadioButton x:Name="CredentialsLoginRadio" GroupName="SteamLoginMethod"
                         Checked="LoginMethodOptionChanged" Margin="0,0,0,10">
                <TextBlock Text="Username &amp; password (typed in this window when needed)" Foreground="{StaticResource BrushTextPrimary}" FontSize="13"/>
            </RadioButton>

            <TextBlock x:Name="SteamUsernameLabel" Text="Steam username" Foreground="{StaticResource BrushTextPrimary}"
                       FontSize="13" FontWeight="SemiBold" Margin="24,0,0,6" Visibility="Collapsed"/>
            <TextBox x:Name="SteamUsernameTextBox" Height="32" Padding="8,5" Margin="24,0,0,0" HorizontalAlignment="Left" Width="280"
                     Background="{StaticResource BrushPanel}" Foreground="{StaticResource BrushTextPrimary}"
                     BorderBrush="{StaticResource BrushBorder}" Visibility="Collapsed"
                     TextChanged="SteamUsernameTextBox_TextChanged"/>
            <TextBlock x:Name="SteamUsernameHintText" Text="You can change this later from Settings in the main window."
                       Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontStyle="Italic"
                       Margin="24,5,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Page>
