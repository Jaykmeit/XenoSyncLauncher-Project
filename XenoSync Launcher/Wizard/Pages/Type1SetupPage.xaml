<Page x:Class="XenoSyncLauncher.Wizard.Pages.Type1SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BrushBackground}">
    <StackPanel Margin="50,35,50,0">
        <TextBlock Text="Modded Installation over Xenoverse 2 Vanilla"
                   Foreground="{StaticResource BrushTextPrimary}"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Aviso de conflictos -->
        <Border Background="#332A1A" BorderBrush="{StaticResource BrushWarning}" BorderThickness="1"
                CornerRadius="4" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="⚠ WARNING" Foreground="{StaticResource BrushWarning}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                <TextBlock Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,0">
                    Installing Xenoverse 2 Modded over your Vanilla directory may cause issues when logging in to Multiplayer Lobbies or online rooms in official Xenoverse 2 Vanilla.

                </TextBlock>
                <TextBlock Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,8">
                    XV2 Patcher and Revamp normally require a previous version to the latest update (downgrade). While the directory path becomes modded, you won't be able to play online as long as XV2 Patcher and mods are installed.

                </TextBlock>
                <TextBlock Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,8">
                    It's also required to disable automatic updates for Xenoverse 2 in Steam in order to avoid Steam overwriting the downgrade for a non-stable Xenoverse version for XV2 Patcher and Revamp.
                </TextBlock>
                <TextBlock>
                    <Hyperlink NavigateUri="https://help.steampowered.com/es/faqs/view/3F62-3D2A-6D3D-2D65"
                               RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource BrushAccent}">
                        How to disable automatic updates for a Steam game in Library
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <CheckBox x:Name="AcknowledgeCheckBox" Content="I've read the previous message and made sure auto-updates are off for Xenoverse 2"
                  Foreground="{StaticResource BrushTextPrimary}" FontSize="13"
                  Margin="0,0,0,25" Checked="AcknowledgeCheckBox_Changed" Unchecked="AcknowledgeCheckBox_Changed"/>

        <TextBlock Text="Xenoverse 2 Vanilla Path" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10">
            This path will become your Modded directory.
        </TextBlock>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="VanillaPathTextBox" Grid.Column="0" Height="32" Padding="8,5"
                     Background="{StaticResource BrushPanel}" Foreground="{StaticResource BrushTextPrimary}"
                     BorderBrush="{StaticResource BrushBorder}" IsReadOnly="True"/>
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Width="100" Margin="10,0,0,0"
                    Style="{StaticResource WizardButton}" Click="BrowseButton_Click"/>
        </Grid>
    </StackPanel>
</Page>
