<Page x:Class="XenoSyncLauncher.Wizard.Pages.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BrushBackground}">
    <StackPanel Margin="50,40,50,0">
        <TextBlock Text="Welcome to XenoSync Launcher"
                   Foreground="{StaticResource BrushTextPrimary}"
                   FontSize="26" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Foreground="{StaticResource BrushTextSecondary}"
                   FontSize="14" TextWrapping="Wrap" Margin="0,0,0,25">
            This first run setup will prepare your Dragon Ball Xenoverse 2 Modded installation.
            Before proceeding, the summary of your initial config will be:
        </TextBlock>

        <StackPanel>
            <TextBlock Text="1. Choosing installation type" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14">
                Installing over Vanilla Xenoverse 2, or in a different path.
            </TextBlock>

            <TextBlock Text="2. Evaluate Xenoverse 2 version" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14">
                The launcher will compare your installed version, the latest available in Steam and the most stable, supported for Xenoverse 2 Revamp to determine whether a downgrade is needed or a Steam update.
            </TextBlock>

            <TextBlock Text="3. Apply needed changes" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14">
                Download/Downgrade via DepotDownloader if needed, installation of XV2Patcher and Xenoverse 2 Revamp.
            </TextBlock>
        </StackPanel>
    </StackPanel>
</Page>
