<Window x:Class="XenoSyncLauncher.MainApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XenoSyncLauncher.MainApp"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="XenoSync Launcher"
        Height="680" Width="1320"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource BrushBackground}">

    <!-- WindowChrome se encarga del arrastre, el redimensionado y de que
         Maximizar no tape la barra de tareas (el fallo típico de quitar
         WindowStyle sin esto). CaptionHeight coincide con la altura de la
         barra superior (56) para que toda esa franja sea arrastrable salvo
         los controles marcados como IsHitTestVisibleInChrome. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Botones de la barra de título: minimizar / maximizar -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de cerrar: mismo patrón pero con el rojo que ya usas en BrushDanger -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushDanger}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Top bar: title, Live/Not Found indicator, Settings gear, controles de ventana -->
        <Border Grid.Row="0"
        Background="{StaticResource BrushPanel}"
        BorderBrush="{StaticResource BrushBorder}"
        BorderThickness="0,0,0,1">

            <Grid>
                <!-- Contenido original, con su margen de 20px respecto a los bordes -->
                <Grid Margin="20,0,0,0">

                    <Image Source="pack://application:,,,/XenoSyncLauncher;component/Assets/img/logo.png"
                       Height="96"
                       Stretch="Uniform"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Left" Width="235" Margin="-7,-24,0,0"/>
                    <Border x:Name="LiveIndicatorBadge"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,4">

                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LiveIndicatorDot"
                             Width="8"
                             Height="8"
                             Fill="{StaticResource BrushDanger}"
                             Margin="0,0,8,0"/>

                            <TextBlock x:Name="LiveIndicatorText"
                               Text="Not Found"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                        </StackPanel>

                    </Border>

                    <TextBlock x:Name="LauncherVersionText"
                       Text="v0.1"
                       Foreground="{StaticResource BrushTextSecondary}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="1109,0,0,0"/>

                    <Button x:Name="SettingsButton"
                    Content="&#9881;"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Left"
                    FontSize="16"
                    Margin="1133,10,0,9"
                    Style="{StaticResource WizardButton}"
                    Click="SettingsButton_Click"
                    ToolTip="Settings"
                    WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>

                <!-- Controles de ventana: minimizar / maximizar-restaurar / cerrar,
                     pegados a la esquina superior derecha, fuera del margen de 20px
                     para que queden al borde como es habitual. -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize"
                            Content="&#xE921;"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="BtnMinimize_Click"
                            ToolTip="Minimizar"/>
                    <Button x:Name="BtnMaximizeRestore"
                            Content="&#xE922;"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="BtnMaximizeRestore_Click"
                            ToolTip="Maximizar"/>
                    <Button x:Name="BtnClose"
                            Content="&#xE8BB;"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            Click="BtnClose_Click"
                            ToolTip="Cerrar"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Main content: mod tree + details / Launch Inspect sidebar -->
        <Grid Grid.Row="1" Margin="20,15,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Mod tree -->
            <Border Grid.Column="0" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Installed Mods" Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ListBox x:Name="ModListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             SelectionChanged="ModListBox_SelectionChanged">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushAccent}"
                                                   FontWeight="Bold" FontSize="12" Margin="0,12,0,4"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{Binding IndentLevel, Converter={x:Static local:IndentLevelToMarginConverter.Instance}}"
                                      Visibility="{Binding IsVisibleInTree, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding IsExpanded, Converter={x:Static local:BoolToArrowConverter.Instance}}"
                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="9" Cursor="Hand"
                                                   VerticalAlignment="Center" MouseLeftButtonUp="ExpandToggle_Click"
                                                   Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsCheckboxEnabled}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextPrimary}"
                                                       FontSize="13" Cursor="Hand"
                                                       MouseEnter="ModTitle_MouseEnter" MouseLeave="ModTitle_MouseLeave"/>
                                            <TextBlock Text="{Binding ParentTitle, StringFormat='Requires: {0}'}"
                                                       Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontStyle="Italic"
                                                       Visibility="{Binding ParentTitle, Converter={x:Static local:NullToVisibilityConverter.Instance}}"/>
                                            <Grid Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0" Height="4" Minimum="0" Maximum="100"
                                                             Value="{Binding DownloadPercent, Mode=OneWay}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DownloadPercent, StringFormat='{}{0:0}%'}"
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="9" Margin="6,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Mod page preview: persistent panel (not a hover popup) showing the
                 selected mod's real page via WebView2. Kept out of any Popup - WebView2
                 doesn't compose reliably inside a transparent/layered Popup (it can pop
                 out as its own OS-chrome window), so it lives in the normal layout instead. -->
            <Border Grid.Column="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Mod Page Preview" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ModPagePreviewAuthorText" Text="" Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="11" FontStyle="Italic" Margin="0,2,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <TextBlock x:Name="ModPagePreviewEmptyText" Text="Select a mod to preview its page here."
                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ModPagePreviewFallbackText" FontSize="12" TextWrapping="Wrap" Margin="14"
                                   Foreground="{StaticResource BrushTextSecondary}" Visibility="Collapsed"
                                   Text="Couldn't load a live preview (the WebView2 Runtime may not be installed). Use 'View mod page' to open it in your browser instead."/>
                        <wv2:WebView2 x:Name="ModPagePreviewWebView" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Sidebar: mod details + Launch Inspect -->
            <StackPanel Grid.Column="4">
                <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Mod Details" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ModDetailTitle" Text="Select a mod" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                        <TextBlock x:Name="ModDetailAuthorText" Text="" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontStyle="Italic" Margin="0,0,0,6" Visibility="Collapsed"/>
                        <TextBlock x:Name="ModDetailDescription" Text="" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button x:Name="VisitModPageButton" Content="View mod page" Style="{StaticResource WizardButton}"
                                HorizontalAlignment="Left" Click="VisitModPageButton_Click" IsEnabled="False"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Launch Inspect" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock Text="Revamp" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Installed" Foreground="{StaticResource BrushTextSecondary}" FontSize="10"/>
                                <TextBlock x:Name="RevampInstalledText" Text="-" Foreground="{StaticResource BrushTextPrimary}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Latest" Foreground="{StaticResource BrushTextSecondary}" FontSize="10"/>
                                <TextBlock x:Name="RevampLatestText" Text="-" Foreground="{StaticResource BrushTextPrimary}" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="XV2Patcher" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Installed" Foreground="{StaticResource BrushTextSecondary}" FontSize="10"/>
                                <TextBlock x:Name="PatcherInstalledText" Text="-" Foreground="{StaticResource BrushTextPrimary}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Latest" Foreground="{StaticResource BrushTextSecondary}" FontSize="10"/>
                                <TextBlock x:Name="PatcherLatestText" Text="-" Foreground="{StaticResource BrushTextPrimary}" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Log console -->
        <Border Grid.Row="2" Margin="20,0,20,10" Background="#14151A" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="Log" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    <Button x:Name="CopyLogButton" Content="Copy Log" Width="80" Height="22" Padding="0" FontSize="10"
                            HorizontalAlignment="Right" Style="{StaticResource WizardButton}" Click="CopyLogButton_Click"/>
                </Grid>
                <!-- Each line is a read-only, borderless TextBox instead of a plain
                     TextBlock: a TextBlock's content can't be mouse-selected at all,
                     which left Copy Log as the only way to get anything out of the
                     log. A read-only TextBox looks identical but supports normal
                     click-drag selection and Ctrl+C per line/partial line. -->
                <ListBox x:Name="LogListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Text, Mode=OneWay}"
                                     Foreground="{Binding ForegroundBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="True"
                                     TextWrapping="Wrap"
                                     Cursor="IBeam"
                                     Padding="0"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     SelectionBrush="{StaticResource BrushAccent}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- Bottom action bar: Update/Pause/Resume + Run -->
        <Border Grid.Row="3" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,10,20,0" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="UpdateStatusPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UpdateTaskText" Grid.Column="0" Text="Downloading..."
                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
                        <TextBlock x:Name="UpdatePercentText" Grid.Column="1" Text="0%"
                                   Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontWeight="SemiBold"/>
                    </Grid>
                    <ProgressBar x:Name="UpdateProgressBar" Grid.Row="1" Height="6" Visibility="Collapsed"/>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Content="Update" Width="110" Height="25" Margin="0,0,10,0"
                            Style="{StaticResource WizardButton}" Click="UpdateButton_Click"/>
                    <Button x:Name="PauseResumeButton" Content="Pause" Width="110" Height="25" Margin="0,0,10,0"
                            Style="{StaticResource WizardButton}" Click="PauseResumeButton_Click" Visibility="Collapsed"/>
                    <Button x:Name="RunButton" Content="Run" Width="110" Height="25"
                            Style="{StaticResource RunButton}" Click="RunButton_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mod hover "bocadillo": a lightweight, chromeless summary next to the
             cursor - title, author credit, description, and a small auto-cycling
             slideshow of curated screenshots. Deliberately has no embedded WebView2
             (that lives in the persistent Mod Page Preview panel instead), which is
             also why hovering it never has the airspace/close issue a windowed
             control inside a transparent Popup would cause. -->
        <Popup x:Name="ModPreviewPopup" AllowsTransparency="True" StaysOpen="True" Placement="Mouse"
               HorizontalOffset="18" VerticalOffset="18" Width="300"
               MouseEnter="ModPreviewPopup_MouseEnter" MouseLeave="ModPreviewPopup_MouseLeave">
            <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ModPreviewScaleTransform" ScaleX="0.85" ScaleY="0.85"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <StackPanel Margin="12">
                    <Border Height="150" Background="{StaticResource BrushBackground}" CornerRadius="5" Margin="0,0,0,8" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="ModPreviewSlideshowImageA" Stretch="UniformToFill" Opacity="1"/>
                            <Image x:Name="ModPreviewSlideshowImageB" Stretch="UniformToFill" Opacity="0"/>
                            <TextBlock x:Name="ModPreviewNoScreenshotsText" Text="No screenshots available"
                                       Foreground="{StaticResource BrushTextSecondary}" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ModPreviewTitleText" Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock x:Name="ModPreviewAuthorText" Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="10" FontStyle="Italic" Margin="0,0,0,6" Visibility="Collapsed"/>
                    <TextBlock x:Name="ModPreviewDescriptionText" Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="11" TextWrapping="Wrap" MaxHeight="70" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
